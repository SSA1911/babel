DEEPGRAM_API_KEY=your_deepgram_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Required for /ws/diarize. diart's default pipeline needs two gated models:
# accept terms at https://huggingface.co/pyannote/segmentation and
# https://huggingface.co/pyannote/embedding, and generate a token at
# https://huggingface.co/settings/tokens.
HUGGINGFACE_TOKEN=your_huggingface_token_here

# Optional overrides
GROQ_MODEL=openai/gpt-oss-120b
TARGET_LANGUAGE=English
DEEPGRAM_STT_MODEL=nova-3
SOURCE_LANGUAGE=en
CORS_ORIGINS=*
DIARIZATION_MAX_SPEAKERS=6
