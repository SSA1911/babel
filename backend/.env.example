DEEPGRAM_API_KEY=your_deepgram_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ---- Translation ----------------------------------------------------------
# auto | fast | quality | allam. qwen3.8-27b covers every source language
# Babel supports and is the verified best pick (2026-10-14 side-by-side vs
# gpt-oss-120b, which is now the backup). "allam" opts into the Arabic
# specialist for Arabic<->English sessions only. Re-run
# scripts/probe_quality_compare.py when the Groq lineup shifts.
GROQ_MODEL_MODE=auto
GROQ_MODEL_FAST=qwen/qwen3.8-27b
GROQ_MODEL_QUALITY=openai/gpt-oss-120b
GROQ_MODEL_ALLAM=allam-2-7b
# Optional: point translation at any OpenAI-compatible endpoint instead of
# Groq (e.g. llama-swap on the LAN serving a self-hosted model). Empty = Groq.
GROQ_BASE_URL=
TARGET_LANGUAGE=English
TRANSLATION_MAX_TOKENS=512
TRANSLATION_CONCURRENCY=3

# ---- Speech-to-text -------------------------------------------------------
DEEPGRAM_STT_MODEL=nova-3
SOURCE_LANGUAGE=en
# Silence (ms) before a segment is finalized -- now the biggest single source
# of perceived lag, since translation itself runs in ~50-100ms. Lower is more
# responsive but fragments sentences across bubbles (and fragments translate
# worse, having lost the rest of the sentence for context). 100 is Deepgram's
# code-switching recommendation; 200 keeps sentences intact; 300 was the old
# value. Tune to taste.
ENDPOINTING_MS=200
UTTERANCE_END_MS=1000

# Languages Deepgram can't code-switch natively each get their own parallel
# connection, billed per connection while listening. The baseline is what a
# typical session costs; the ceiling is a runaway guard. Selecting 3 outlier
# languages legitimately opens 3 connections.
STT_CONNECTION_BASELINE=2
STT_CONNECTION_CEILING=4
# How long (ms) to hold a finalized segment waiting for the other connections'
# competing transcriptions of the same audio before picking a winner.
ARBITRATION_GRACE_MS=250
# Two hypotheses within this confidence margin are treated as code-switched
# speech and both go to the translator to reconstruct. Set 0 to disable.
FUSION_MARGIN=0.15

CORS_ORIGINS=*

# ---- Access control ---------------------------------------------------------
# Optional shared secret for both WebSocket endpoints. Empty = open (fine for
# Tailscale-only use). When set, clients must connect with &token=<value>
# (the web app asks for it in Settings). Prevents anyone reachable from
# opening streams that burn Deepgram + Groq credits.
BABEL_WS_TOKEN=
